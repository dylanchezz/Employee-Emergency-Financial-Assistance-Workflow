# Normalize line endings across machines to prevent CRLF/LF merge conflicts.
# Git stores text with LF; checks out with the platform's native endings.
* text=auto

# Force LF for these regardless of platform (scripts/config that must stay LF)
*.py    text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cs    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Treat these as binary (never touch line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.joblib binary
*.pkl   binary
*.xlsx  binary
*.docx  binary
